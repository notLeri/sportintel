# Local defaults. Copy: cp .env.example .env
# The full variable list is the "Configuration" table in the README. Never put secrets here.

ENV=local
# VERSION is baked into the image at build time (--build-arg VERSION); "dev" locally.

DATABASE_URL=postgresql+psycopg://sportintel:sportintel@localhost:5432/sportintel
DATABASE_URL_MIGRATOR=postgresql+psycopg://sportintel:sportintel@localhost:5432/sportintel
DB_POOL_SIZE=10

APP_BASE_URL=http://localhost:8000

# OIDC is optional; set all three OIDC_* or none
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
DEV_LOGIN_ENABLED=true

# ADR-004: none = no LLM (rules and templates); ollama = local LLM at OLLAMA_URL
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
AI_RECORD=false
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=180
OLLAMA_CONCURRENCY=1

SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

FETCH_USER_AGENT="SportIntelBot/1.0 (+http://localhost:8000/bot)"
WORKER_CONCURRENCY=4
WORKER_FETCH_CONCURRENCY=4
WORKER_INTERACTIVE_CONCURRENCY=2

LOG_LEVEL=INFO
LOG_FORMAT=console

# ENV=e2e only; must be empty in every other environment
SAFE_FETCH_ALLOW_HOSTS=
# VPN with fake-ip DNS (Clash, sing-box, Surge…): sources fail with ssrf_blocked → true
SAFE_FETCH_ALLOW_FAKE_IP=false
STATIC_DIR=./frontend/dist
PORT=8000
CSP_MODE=report-only

# Feature flags (CONV §9)
FLAG_REQUIRE_SECOND_REVIEWER=false
FLAG_BROWSER_NOTIFICATIONS=false
FLAG_TELEGRAM_PUBLISH=true
