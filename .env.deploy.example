# Production setup: cp .env.deploy.example .env, fill in the REQUIRED block, then
#   docker compose up -d --build
# Details: deploy/README.md. .env holds secrets: never commit or share it.

# ===== REQUIRED =====
# A domain whose A record points to this server (ports 80 and 443 open).
# To try it on your own computer use localhost (local certificate, the browser will warn).
DOMAIN=sportintel.example.com

# production | staging (staging is the same plus API docs at /api/v1/docs)
ENV=production

# Database password: letters and digits only (it is part of the connection URL), 24+ characters.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# First administrator: created on first start while the system has no admin.
# Password: at least 10 characters; change it after signing in under Admin → Users.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# ===== AI (briefs, translation, short posts): pick one option =====
# 1) No AI: everything runs on rules and templates.
AI_PROVIDER=none
# 2) Anthropic API (paid, fast, needs only network access):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# 3) Ollama on this server (free, needs ≥16 GB RAM; models download themselves):
# AI_PROVIDER=ollama
# COMPOSE_PROFILES=llm
# LLM_MODEL=qwen3:14b
# TRANSLATION_MODEL=gemma3:12b
# 4) Ollama on another machine in your network (e.g. over Tailscale):
# AI_PROVIDER=ollama
# OLLAMA_URL=http://100.64.0.10:11434
OLLAMA_TIMEOUT_S=180

# ===== Optional =====
# Publishing to Telegram channels: docs/TELEGRAM_BOT_SETUP.md
TELEGRAM_BOT_TOKEN=
FLAG_TELEGRAM_PUBLISH=false

# Alerts about silent failures (a source goes quiet, a queue grows) to a Telegram chat
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Google sign-in (OIDC). Empty: no Google button, sign-in by e-mail and password.
# Set all three or none. Redirect URI in Google: https://<DOMAIN>/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=

# Errors to Sentry
SENTRY_DSN=

# Database backups in ./backups: how many to keep and how often (hours)
BACKUP_KEEP=14
BACKUP_INTERVAL_H=24

# A prebuilt image instead of building on the server (if you publish one), e.g.:
# IMAGE=ghcr.io/<owner>/sportintel:<tag>
