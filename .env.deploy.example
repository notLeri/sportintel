# Боевая установка: cp .env.deploy.example .env, заполнить блок «ОБЯЗАТЕЛЬНО», затем
#   docker compose up -d --build
# Подробно — deploy/README.md. Файл .env содержит секреты: не коммитить, не пересылать.

# ===== ОБЯЗАТЕЛЬНО =====
# Домен, A-запись которого указывает на этот сервер (порты 80 и 443 открыты).
# Для пробы на своём компьютере — localhost (сертификат локальный, браузер предупредит).
DOMAIN=sportintel.example.com

# production | staging (staging — то же самое, но с документацией API на /api/v1/docs)
ENV=production

# Пароль базы: только буквы и цифры (он входит в URL подключения), 24+ символа.
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Первый администратор: создаётся при первом запуске, пока в системе нет ни одного admin.
# Пароль — не короче 10 символов; после входа его можно сменить в «Админка → Пользователи».
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# ===== ИИ (брифы, перевод, короткие посты) — выберите один вариант =====
# 1) Без ИИ: всё работает на правилах и шаблонах.
AI_PROVIDER=none
# 2) Anthropic API (платно, быстро, нужна только сеть):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# 3) Ollama на этом же сервере (бесплатно, нужно ≥16 ГБ RAM; модель скачается сама):
# AI_PROVIDER=ollama
# COMPOSE_PROFILES=llm
# LLM_MODEL=qwen3:14b
# TRANSLATION_MODEL=gemma3:12b
# 4) Ollama на другой машине в вашей сети (например, через Tailscale):
# AI_PROVIDER=ollama
# OLLAMA_URL=http://100.64.0.10:11434
OLLAMA_TIMEOUT_S=180

# ===== Необязательно =====
# Публикация в Telegram-каналы: docs/TELEGRAM_BOT_SETUP.md
TELEGRAM_BOT_TOKEN=
FLAG_TELEGRAM_PUBLISH=false

# Оповещения о тихих сбоях (источник молчит, очередь растёт) — в Telegram-чат
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Вход через Google (OIDC). Пусто — кнопки Google нет, вход по e-mail и паролю.
# Задавать все три или ни одной. Redirect URI в Google: https://<DOMAIN>/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=

# Ошибки в Sentry
SENTRY_DSN=

# Бэкапы базы в ./backups: сколько хранить и как часто (часы)
BACKUP_KEEP=14
BACKUP_INTERVAL_H=24

# Готовый образ вместо сборки на сервере (если публикуется в реестр), например:
# IMAGE=ghcr.io/<owner>/sportintel:<tag>
