{
  "name": "sportintel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "routes": "tsr generate",
    "gen:api": "openapi-typescript ../openapi.json -o src/shared/api/generated/schema.d.ts",
    "check:api": "openapi-typescript ../openapi.json -o node_modules/.tmp/schema.check.d.ts && diff -q src/shared/api/generated/schema.d.ts node_modules/.tmp/schema.check.d.ts",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@sentry/react": "^10",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/react-virtual": "3.13.12",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "3.4.17",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "lucide-react": "^1.52.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "^1",
    "@tanstack/router-plugin": "^1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^15",
    "msw": "^2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
