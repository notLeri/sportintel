  "narrative": {
    "northStar": "Concreto",
    "overview": "SportIntel is an editorial desk drawn in the language of Brazilian concrete art and modernist identity design: flat fields of flag colour, a strict grid, square geometry. It is a working tool first; the world lends palette, type, density and one signature move. Colour does real jobs: green owns navigation and selection, yellow means look here, blue means AI and editorial approval. The signature move is trust drawn as geometry: one square per outlet that reported an event.",
    "keyCharacteristics": [
      "Flat flag-colour fields, with no gradients, glass or decorative shadows.",
      "Square corners (0–2px) and hard 1.5px ink strokes on controls.",
      "Ink text on flag green (4.9:1), never white on green.",
      "Confirmation squares and source blocks as the recurring signature.",
      "Light and dark themes share the same flag colours. Only the ground, surfaces and text flip."
    ],
    "rules": [
      {
        "name": "The Unique Field Rule",
        "body": "Solid flag green is reserved for the rail, the selected row, primary buttons, high trust and independent source blocks. Filters and other selections use a green stroke instead.",
        "section": "colors"
      },
      {
        "name": "The One Job Rule",
        "body": "Each flag hue means one thing. Green is \"you are here / confirmed\", yellow is \"look here\", blue is \"AI or approved\". Never use a flag colour as decoration.",
        "section": "colors"
      },
      {
        "name": "The Ink-on-Flag Rule",
        "body": "Text on flag green or yellow is ink (#0e1a13). The .on-flag class re-points the subtree's tokens to ink, so badges and secondary text inside a selected row stay legible.",
        "section": "colors"
      },
      {
        "name": "The Poster Voice Rule",
        "body": "Unbounded is only for titles that name a page or an event, plus the wordmark. It is never used for controls, badges or data.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Times, counts and tables use tabular numerals, so columns align.",
        "section": "typography"
      },
      {
        "name": "The Flat Field Rule",
        "body": "No box-shadows, gradients or blur. Anything that floats gets a 1.5px ink border.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put ink text on flag green and yellow. Wrap selected or green subtrees in .on-flag.",
      "Do pair every level with an icon and text, so it reads without colour (WCAG 1.4.1).",
      "Do give every badge, filter, score and action a hint, and give touch targets visible labels.",
      "Do use bg-primary / text-brand-text / bg-attention / bg-ai tokens instead of Tailwind palette colours.",
      "Do keep motion to entrances that happen occasionally (new events bar, source blocks, login poster), and never on keyboard navigation (j/k)."
    ],
    "donts": [
      "Don't use white text on flag green (3.6:1).",
      "Don't add box-shadows, gradients, glass or pill shapes.",
      "Don't use emoji as icons. Use lucide icons.",
      "Don't add a coloured left border to rows or cards to mark importance. Use the importance badge.",
      "Don't set controls, badges or data in Unbounded."
    ]
  }
