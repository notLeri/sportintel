# Reverse proxy with automatic HTTPS (Let's Encrypt) for the domain from .env.
# DOMAIN=localhost uses Caddy's local certificate (the browser warns once).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000 {
		# while web restarts, Caddy waits up to 30 s instead of returning 502 at once
		lb_try_duration 30s
	}
}
